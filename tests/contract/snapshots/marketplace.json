 "create_proposal_draft": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": false
  },
  "input": {
   "properties": {
    "bid_amount": {
     "description": "Total for fixed jobs, USD/hour for hourly jobs.",
     "exclusiveMinimum": 0,
     "maximum": 100000,
     "title": "Bid Amount",
     "type": "number"
    },
    "bid_type": {
     "pattern": "^(fixed|hourly)$",
     "title": "Bid Type",
     "type": "string"
    },
    "cover_letter": {
     "maxLength": 5000,
     "minLength": 50,
     "title": "Cover Letter",
     "type": "string"
    },
    "dry_run": {
     "default": true,
     "title": "Dry Run",
     "type": "boolean"
    },
    "idempotency_key": {
     "description": "Stable key for this logical write; retries with the same key never repeat it.",
     "maxLength": 128,
     "minLength": 8,
     "pattern": "^[A-Za-z0-9:_\\-.]+$",
     "title": "Idempotency Key",
     "type": "string"
    },
    "job_id": {
     "maxLength": 64,
     "minLength": 1,
     "title": "Job Id",
     "type": "string"
    },
    "screening_answers": {
     "default": [],
     "items": {
      "maxLength": 2000,
      "type": "string"
     },
     "maxItems": 10,
     "title": "Screening Answers",
     "type": "array"
    },
    "trace_id": {
     "default": "",
     "description": "Trace id propagated from the caller.",
     "maxLength": 64,
     "title": "Trace Id",
     "type": "string"
    }
   },
   "required": [
    "job_id",
    "cover_letter",
    "bid_amount",
    "bid_type",
    "idempotency_key"
   ],
   "title": "create_proposal_draftArguments",
   "type": "object"
  },
  "output": {
   "properties": {
    "action": {
     "title": "Action",
     "type": "string"
    },
    "balance_after": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Balance After"
    },
    "balance_before": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Balance Before"
    },
    "connects_cost": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Connects Cost"
    },
    "dry_run": {
     "title": "Dry Run",
     "type": "boolean"
    },
    "idempotent_replay": {
     "default": false,
     "title": "Idempotent Replay",
     "type": "boolean"
    },
    "ok": {
     "title": "Ok",
     "type": "boolean"
    },
    "problems": {
     "items": {
      "type": "string"
     },
     "title": "Problems",
     "type": "array"
    },
    "result": {
     "additionalProperties": true,
     "title": "Result",
     "type": "object"
    },
    "would_send": {
     "anyOf": [
      {
       "additionalProperties": true,
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Exact payload that will be sent (dry_run).",
     "title": "Would Send"
    }
   },
   "required": [
    "ok",
    "dry_run",
    "action"
   ],
   "title": "WriteResult",
   "type": "object"
  }
 },
