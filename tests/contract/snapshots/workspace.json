{
 "_prompts": [],
 "_resource_templates": [],
 "create_email_draft": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "input": {
   "properties": {
    "body": {
     "maxLength": 6000,
     "minLength": 1,
     "title": "Body",
     "type": "string"
    },
    "idempotency_key": {
     "maxLength": 128,
     "minLength": 8,
     "pattern": "^[A-Za-z0-9:_\\-.]+$",
     "title": "Idempotency Key",
     "type": "string"
    },
    "subject": {
     "maxLength": 200,
     "minLength": 1,
     "title": "Subject",
     "type": "string"
    },
    "to": {
     "maxLength": 200,
     "minLength": 3,
     "title": "To",
     "type": "string"
    },
    "trace_id": {
     "default": "",
     "maxLength": 64,
     "title": "Trace Id",
     "type": "string"
    }
   },
   "required": [
    "to",
    "subject",
    "body",
    "idempotency_key"
   ],
   "title": "create_email_draftArguments",
   "type": "object"
  },
  "output": {
   "properties": {
    "body": {
     "title": "Body",
     "type": "string"
    },
    "id": {
     "title": "Id",
     "type": "string"
    },
    "idempotent_replay": {
     "default": false,
     "title": "Idempotent Replay",
     "type": "boolean"
    },
    "status": {
     "default": "draft",
     "title": "Status",
     "type": "string"
    },
    "subject": {
     "title": "Subject",
     "type": "string"
    },
    "to": {
     "title": "To",
     "type": "string"
    }
   },
   "required": [
    "id",
    "to",
    "subject",
    "body"
   ],
   "title": "EmailDraft",
   "type": "object"
  }
 },
 "create_interview_hold": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "input": {
   "properties": {
    "end": {
     "description": "ISO-8601 end",
     "title": "End",
     "type": "string"
    },
    "idempotency_key": {
     "maxLength": 128,
     "minLength": 8,
     "pattern": "^[A-Za-z0-9:_\\-.]+$",
     "title": "Idempotency Key",
     "type": "string"
    },
    "start": {
     "description": "ISO-8601 start returned by free_slots",
     "title": "Start",
     "type": "string"
    },
    "title": {
     "maxLength": 200,
     "minLength": 3,
     "title": "Title",
     "type": "string"
    },
    "trace_id": {
     "default": "",
     "maxLength": 64,
     "title": "Trace Id",
     "type": "string"
    }
   },
   "required": [
    "start",
    "end",
    "title",
    "idempotency_key"
   ],
   "title": "create_interview_holdArguments",
   "type": "object"
  },
  "output": {
   "properties": {
    "end": {
     "title": "End",
     "type": "string"
    },
    "id": {
     "title": "Id",
     "type": "string"
    },
    "idempotent_replay": {
     "default": false,
     "title": "Idempotent Replay",
     "type": "boolean"
    },
    "start": {
     "title": "Start",
     "type": "string"
    },
    "status": {
     "default": "tentative",
     "title": "Status",
     "type": "string"
    },
    "title": {
     "title": "Title",
     "type": "string"
    }
   },
   "required": [
    "id",
    "start",
    "end",
    "title"
   ],
   "title": "Hold",
   "type": "object"
  }
 },
 "free_slots": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "input": {
   "properties": {
    "days_ahead": {
     "default": 5,
     "maximum": 14,
     "minimum": 1,
     "title": "Days Ahead",
     "type": "integer"
    },
    "duration_minutes": {
     "default": 30,
     "maximum": 120,
     "minimum": 15,
     "title": "Duration Minutes",
     "type": "integer"
    },
    "max_slots": {
     "default": 3,
     "maximum": 10,
     "minimum": 1,
     "title": "Max Slots",
     "type": "integer"
    },
    "start_date": {
     "anyOf": [
      {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Start Date"
    },
    "timezone": {
     "default": "Asia/Karachi",
     "maxLength": 64,
     "title": "Timezone",
     "type": "string"
    },
    "trace_id": {
     "default": "",
     "maxLength": 64,
     "title": "Trace Id",
     "type": "string"
    }
   },
   "title": "free_slotsArguments",
   "type": "object"
  },
  "output": {
   "$defs": {
    "Slot": {
     "properties": {
      "end": {
       "title": "End",
       "type": "string"
      },
      "label": {
       "description": "Human-friendly label, e.g. 'Tue 12 Nov, 3:00-3:30 PM PKT'",
       "title": "Label",
       "type": "string"
      },
      "start": {
       "description": "ISO-8601 start in the requested timezone",
       "title": "Start",
       "type": "string"
      }
     },
     "required": [
      "start",
      "end",
      "label"
     ],
     "title": "Slot",
     "type": "object"
    }
   },
   "properties": {
    "slots": {
     "items": {
      "$ref": "#/$defs/Slot"
     },
     "title": "Slots",
     "type": "array"
    },
    "timezone": {
     "title": "Timezone",
     "type": "string"
    }
   },
   "required": [
    "timezone",
    "slots"
   ],
   "title": "SlotList",
   "type": "object"
  }
 }
}