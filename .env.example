# Copy to .env and fill in.  Never commit .env.
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

# --- data stores (empty DATABASE_URL -> local SQLite file for laptop/tests)
DATABASE_URL=
REDIS_URL=

# --- marketplace
MARKETPLACE_MODE=gigsim
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_ADMIN_TOKEN=change-me
GIGSIM_POLICY_VERSION=2026-11-02
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=

# --- MCP servers (stdio spawns them locally; http uses the URLs below)
MCP_TRANSPORT=stdio
MCP_MARKETPLACE_URL=http://localhost:8091/mcp
MCP_PORTFOLIO_URL=http://localhost:8092/mcp
MCP_WORKSPACE_URL=http://localhost:8093/mcp
MCP_SHARED_SECRET=change-me
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_TOKEN=

# --- models (open profile runs on Groq's hosted open-weight models)
MODEL_PROFILE=open
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_OFFLINE=false

# --- tracing (Langfuse Cloud or self-hosted)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- reviewer account seeded at startup
REVIEWER_EMAIL=reviewer@gigbid.app
REVIEWER_PASSWORD=
