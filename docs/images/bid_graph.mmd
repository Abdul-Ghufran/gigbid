	__start__ --> intake;
	analyst --> decide;
	approval -.-> __end__;
	approval -.-> record_edit;
	approval -.-> submit;
	compliance_guard -.-> __end__;
	compliance_guard -.-> prepare_approval;
	critic -.-> __end__;
	critic -.-> compliance_guard;
	critic -.-> writer;
	decide -.-> __end__;
	decide -.-> pricing;
	fit_matcher --> decide;
	intake -.-> __end__;
	intake -.-> analyst;
	intake -.-> fit_matcher;
	intake -.-> risk_assessor;
	prepare_approval -.-> __end__;
	prepare_approval -.-> approval;
	pricing -.-> __end__;
	pricing -.-> writer;
	record_edit --> compliance_guard;
	risk_assessor --> decide;
	verifier --> critic;
	writer --> verifier;
	submit --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
